{
  "name": "lumina-os-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint app modules shared db tests lib scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/unit/*.test.ts",
    "test:integration": "node --env-file=.env.migrations.local --experimental-strip-types --test tests/integration/**/*.test.ts",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env.migrations.local --experimental-strip-types scripts/seed-system.ts",
    "db:reset-import": "node --env-file=.env.migrations.local --experimental-strip-types scripts/reset-and-import-workbook.ts",
    "auth:bootstrap": "node --env-file=.env.migrations.local --env-file=.env.bootstrap.local --experimental-strip-types scripts/bootstrap-admin.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@neondatabase/serverless": "latest",
    "@shadcn/react": "0.3.0",
    "better-auth": "latest",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "exceljs": "^4.4.0",
    "input-otp": "1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "next": "latest",
    "pg": "latest",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "latest",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
